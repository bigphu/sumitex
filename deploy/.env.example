# SumiTeX settings. Copy to .env and fill in; deploy/README.md explains
# each part. After a change: docker compose up -d

# ----- Where and what -------------------------------------------------
# Everything SumiTeX stores (projects, database, cache). An absolute path.
SUMITEX_DATA_DIR=/srv/sumitex
# The image deploy/build-image made (or one you pulled)
SUMITEX_IMAGE=sumitex/sumitex
SUMITEX_VERSION=0.5.1
# Where SumiTeX listens on this machine. Keep 127.0.0.1 and put a
# reverse proxy with HTTPS in front (see the guide).
SUMITEX_LISTEN_IP=127.0.0.1
SUMITEX_PORT=8080
# Sandboxed compiles on. For trusted users only, without Docker-in-Docker:
# COMPOSE_FILE=docker-compose.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.sandbox.yml
# On a small server (4 GB of memory), also cap MongoDB's memory:
# COMPOSE_FILE=docker-compose.yml:docker-compose.sandbox.yml:docker-compose.small.yml

# ----- Your site -------------------------------------------------------
OVERLEAF_APP_NAME=SumiTeX
OVERLEAF_NAV_TITLE=SumiTeX
OVERLEAF_SITE_URL=https://latex.example.com
# OVERLEAF_ADMIN_EMAIL=admin@example.com
# OVERLEAF_SITE_LANGUAGE=en

# Required. Generate each with: openssl rand -hex 32
OVERLEAF_INVITE_TOKEN_SECRET=
OVERLEAF_SESSION_SECRET=

# Served over HTTPS (through your proxy)? Uncomment. Any value turns it
# on, so leave the line out entirely for plain HTTP.
# OVERLEAF_SECURE_COOKIE=true

ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true
# Set to false once email works, to have new users confirm their address
EMAIL_CONFIRMATION_DISABLED=true

# ----- TeX Live (sandboxed compiles) ----------------------------------
# Pull these before the first start (the guide shows how). The first is
# the default; users can pick another in the project's settings.
TEX_LIVE_DOCKER_IMAGE=ghcr.io/ayaka-notes/texlive-full:2026.1
ALL_TEX_LIVE_DOCKER_IMAGES=ghcr.io/ayaka-notes/texlive-full:2026.1
ALL_TEX_LIVE_DOCKER_IMAGE_NAMES=TeX Live 2026

# ----- SumiTeX guide (optional) ----------------------------------------
# A handbook every user gets read-only, and a playground each user copies.
# As an admin, upload guide/so-tay and guide/san-tap as projects, then put
# their ids here (the id is the last part of the project's address). See
# "The SumiTeX guide" in the deploy guide.
# SUMITEX_GUIDE_PROJECT_ID=
# SUMITEX_PLAYGROUND_PROJECT_ID=

# ----- Email (optional, for invites and password resets) --------------
# OVERLEAF_EMAIL_FROM_ADDRESS=latex@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=

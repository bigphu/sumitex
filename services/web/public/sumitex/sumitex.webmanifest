{
  "id": "/project",
  "name": "SumiTeX",
  "short_name": "SumiTeX",
  "description": "A quiet LaTeX editor",
  "start_url": "/project",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "theme_color": "#0B0D10",
  "background_color": "#0B0D10",
  "icons": [
    { "src": "/sumitex/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/sumitex/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/sumitex/icon-512.svg", "sizes": "any", "type": "image/svg+xml" },
    {
      "src": "/sumitex/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
